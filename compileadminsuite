#!/usr/bin/env bash
set -e

# Detect python interpreter with PyInstaller
if [ -f "/home/arun/myvenv/bin/python" ]; then
    PYTHON_CMD="/home/arun/myvenv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_CMD="python3"
else
    PYTHON_CMD="python"
fi

ICON_ARGS=()
if [ -f "icon.ico" ]; then
    ICON_ARGS+=(--icon=icon.ico)
fi

echo "Using Python: $PYTHON_CMD"
echo "Starting PyInstaller build for AdminSuite..."

$PYTHON_CMD -m PyInstaller \
  --noconfirm \
  --clean \
  --onefile \
  --windowed \
  --name AdminSuite \
  "${ICON_ARGS[@]}" \
  --paths . \
  --paths .. \
  --optimize 2 \
  --collect-all PyQt6 \
  --collect-all PyQt6.QtWebEngineCore \
  --collect-all PyQt6.QtWebEngineWidgets \
  --collect-all PyQt6.QtWebChannel \
  --collect-all paramiko \
  --collect-all sshtunnel \
  --collect-all keyring \
  --collect-all pymysql \
  --collect-all psycopg2 \
  --hidden-import admin_suite \
  --hidden-import admin_suite.app \
  --hidden-import admin_suite.services \
  --hidden-import admin_suite.ui.main_window \
  --hidden-import admin_suite.db.backends.postgres \
  --hidden-import admin_suite.ai \
  --hidden-import admin_suite.ai.assistant_tab \
  --hidden-import admin_suite.ai.ollama_client \
  --hidden-import admin_suite.web \
  --hidden-import admin_suite.security \
  --hidden-import admin_suite.security.malware_scanner \
  --hidden-import admin_suite.security.ssl_auditor \
  --hidden-import admin_suite.vapt \
  --hidden-import admin_suite.vapt.tab \
  --hidden-import admin_suite.vapt.engine \
  --hidden-import admin_suite.vapt.reporter \
  --hidden-import admin_suite.sysadmin.presenter \
  --hidden-import admin_suite.ui.linux_settings_dialog \
  --collect-binaries PyQt6 \
  --collect-datas admin_suite \
  --add-data "icon.png:." \
  --add-data "resources:resources" \
  admin_entry.py

echo "Build completed successfully! Binary located in dist/AdminSuite"
